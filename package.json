{
  "name": "3d-toys-and-render-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "start": "node src/features/studio-server/start-server.js",
    "dev": "node --watch src/features/studio-server/start-server.js",
    "toys": "node src/features/multiplayer-rooms/start-server.js",
    "test": "node --test \"src/features/toy-box/common/*.test.js\" \"src/features/toy-box/common/party-royale/*.test.js\" \"src/features/multiplayer-rooms/*.test.js\" \"src/features/toy-box/eight-ball-pool/*.test.js\" \"src/features/toy-box/physics-portfolio-builder/*.test.js\"",
    "load-test": "node src/features/multiplayer-rooms/room-load-test.js",
    "capacity-test": "node src/features/multiplayer-rooms/room-capacity-test.js",
    "capture": "node src/features/demo-capture/capture-demos.js",
    "instagram": "node src/features/demo-capture/capture-instagram-reels.js",
    "instagram:upload": "node src/features/demo-capture/upload-reels.js"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@vercel/blob": "^1.1.1",
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=22"
  }
}
