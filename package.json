{
  "name": "3d-toys-and-render-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "start": "node src/features/studio-server/start-server.ts",
    "dev": "node --watch src/features/studio-server/start-server.ts",
    "toys": "node src/features/multiplayer-rooms/start-server.ts",
    "test": "node --test \"src/features/toy-box/common/*.test.ts\" \"src/features/toy-box/common/party-royale/*.test.ts\" \"src/features/toy-box/common/server-run/*.test.ts\" \"src/features/multiplayer-rooms/*.test.ts\" \"src/features/toy-box/eight-ball-pool/*.test.ts\" \"src/features/toy-box/physics-portfolio-builder/*.test.ts\" \"src/features/toy-box/voxel-build-together/*.test.ts\" \"src/features/toy-box/wheres-waldo-game/*.test.ts\" \"src/features/toy-feedback/*.test.ts\" \"src/features/balance-audit/*.test.ts\"",
    "load-test": "node src/features/multiplayer-rooms/room-load-test.ts",
    "capacity-test": "node src/features/multiplayer-rooms/room-capacity-test.ts",
    "audit:live": "node src/features/balance-audit/live-match-audit.ts",
    "audit:sims": "node src/features/balance-audit/server-sim-audit.ts",
    "audit:voxel": "node src/features/balance-audit/voxel-sync-audit.ts",
    "capture": "node src/features/poster-capture/capture-posters.ts"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.160.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
