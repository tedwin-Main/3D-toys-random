// Configures the Cloudflare room relay: worker entry, global Durable Object binding, SQLite class migration (free plan).
{
  "name": "toy-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomRelayDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomRelayDO"] }],
  "observability": { "enabled": true }
}
