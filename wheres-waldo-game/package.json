{
  "name": "wheres-waldo-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch backend/start-server.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node backend/start-server.ts",
    "test": "node --test backend/*.test.ts tests/*.test.ts",
    "test:api": "node --test tests/game-socket.test.ts",
    "test:e2e": "node tests/smoke.e2e.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
